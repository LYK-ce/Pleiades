# Profile 程序: 填充固定 tensor → 单次前向推理
# hidden_dim 通过 $hidden_dim 变量注入

[[instructions]]
type = "Const"
value_type = "F64"
value = "1"
dst = "META7"

[[instructions]]
type = "Const"
value_type = "F64"
value = "1"
dst = "META8"

[[instructions]]
type = "Const"
value_type = "F64"
value = "$hidden_dim"
dst = "META3"

[[instructions]]
type = "FillTensor"
dst = "TENSOR1"
shape_slots = ["META7", "META8", "META3"]
value = 1.0

[[instructions]]
type = "Inference"
input_type = "Tensor"
input = "TENSOR1"
