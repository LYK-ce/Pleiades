; Presented by KeJi
; Created Date ： 2026-10-21
; Modified Date ： 2026-10-21
;
; 四旋翼底盘组件 quadrotor_uav（Step 7）。节点树与接口见 COMPONENTS.md §4.6。
; 根节点 Node3D + Quadrotor.gd（extends ChassisModel）；Rotors/* 是**纯视觉**件，
;   不参与物理：碰撞形状只有 Vehicle/CollisionShape3D 一个（由底盘 Configure -> SetBodySize 定尺寸 (size, 0.12, size)）。
; 旋翼是平盘：CylinderMesh 默认轴 = Y，不需要转轴；位置由 Quadrotor._layout_rotors() 按 size 摆
;   （下面的 position 是 size=0.40 的默认摆位，场景与脚本必须一致）。
; 手写维护：不要用编辑器另存（会丢头注释，COMPONENTS.md §9.1 E8）。

[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/chassis/Quadrotor.gd" id="1_quadrotor"]

[sub_resource type="CylinderMesh" id="CylinderMesh_rotor"]
top_radius = 0.12
bottom_radius = 0.12
height = 0.02
radial_segments = 16

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_rotor"]
albedo_color = Color(0.15, 0.16, 0.18, 1)
roughness = 0.6

[node name="Quadrotor" type="Node3D"]
script = ExtResource("1_quadrotor")

[node name="Rotors" type="Node3D" parent="."]

[node name="RotorFL" type="MeshInstance3D" parent="Rotors"]
position = Vector3(0.2, 0.13, -0.2)
mesh = SubResource("CylinderMesh_rotor")
surface_material_override/0 = SubResource("StandardMaterial3D_rotor")

[node name="RotorFR" type="MeshInstance3D" parent="Rotors"]
position = Vector3(0.2, 0.13, 0.2)
mesh = SubResource("CylinderMesh_rotor")
surface_material_override/0 = SubResource("StandardMaterial3D_rotor")

[node name="RotorRL" type="MeshInstance3D" parent="Rotors"]
position = Vector3(-0.2, 0.13, -0.2)
mesh = SubResource("CylinderMesh_rotor")
surface_material_override/0 = SubResource("StandardMaterial3D_rotor")

[node name="RotorRR" type="MeshInstance3D" parent="Rotors"]
position = Vector3(-0.2, 0.13, 0.2)
mesh = SubResource("CylinderMesh_rotor")
surface_material_override/0 = SubResource("StandardMaterial3D_rotor")
