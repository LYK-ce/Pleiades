; Presented by KeJi
; Created Date ： 2026-10-21
; Modified Date ： 2026-10-23
;
; 传感器组件 lidar_2d（Step 8）。节点树与接口见 COMPONENTS.md §4.7。
; 根节点 Node3D：position / rotation.y 由 Vehicle.AttachSensor() 按 mount 外参写入，本场景不写死。
; 参数不走场景（默认值唯一来源 = Lidar2D.gd + SensorCatalog.DEFAULTS）。
; 节点引用必须靠 node_paths=PackedStringArray(...)（COMPONENTS.md §9.1 E16）。
; 手写维护：不要用编辑器另存（会丢头注释、load_steps 会漂，COMPONENTS.md §9.1 E8）。
;
; task_33 Step 3：Body = assets/sensors/lidar_tmini.glb 的实例（**纯视觉**，不得带任何碰撞体，§9.1 E27；
;   否则雷达会扫到自己的壳）。模型原点 = 罐体底面中心 = 扫描面中心（D8），
;   模型 +X 就是 0° 射线方向（射线 = basis * (cos a, 0, sin a)），所以 Body 的 transform 恒 identity。
;   Body 是 glb 实例根（Node3D），子节点才是 MeshInstance3D（Base/Can/Window/FrontBump）。

[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/sensors/Lidar2D.gd" id="1_lidar"]
[ext_resource type="PackedScene" path="res://assets/sensors/lidar_tmini.glb" id="2_lidar_body"]

[node name="Lidar2D" type="Node3D" node_paths=PackedStringArray("debug_points")]
script = ExtResource("1_lidar")
debug_points = NodePath("DebugPoints")

[node name="Body" parent="." instance=ExtResource("2_lidar_body")]

[node name="DebugPoints" type="MeshInstance3D" parent="."]
visible = false
